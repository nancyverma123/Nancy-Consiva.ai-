# --- Groq (chat + speech-to-text, OpenAI-compatible) ---
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Embeddings: local multilingual-e5-small, int8 ONNX (no API key, no network call) ---
EMBEDDING_MODEL_DIR=models/multilingual-e5-small
EMBEDDING_MODEL_FILE=model_quantized.onnx
EMBEDDING_DIMENSIONS=384

# --- Pinecone ---
PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX_NAME=consiva-knowledge-384
PINECONE_NAMESPACE=consiva-production
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Retrieval tuning ---
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.81
RAG_MAX_CONTEXT_CHARS=6000

# --- Database ---
DATABASE_URL=sqlite:///./consiva.db
# PostgreSQL for production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/consiva

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Language ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,es,fr,de,ar

# --- CORS / App ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:8000
APP_NAME=Consiva AI Chatbot
ENVIRONMENT=development

# --- ElevenLabs (text-to-speech) ---
ELEVENLABS_API_KEY=sk-your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=QIhD5ivPGEoYZQDocuHI
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional per-language voice overrides, e.g. ELEVENLABS_VOICE_ID_HI=..., ELEVENLABS_VOICE_ID_AR=...

# --- Guardrails ---
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_BLOCK_THRESHOLD=0.9
GUARD_ALLOWED_LINK_DOMAINS=consiva.ai

# --- Rate limits (per backend process) ---
RATE_CHAT_PER_MINUTE=12
RATE_CHAT_PER_DAY=200
RATE_VOICE_PER_MINUTE=20
RATE_GUEST_SESSIONS_PER_HOUR=20
# Only set true when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
